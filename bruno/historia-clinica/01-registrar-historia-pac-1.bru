meta {
  name: 01 Registrar historia del paciente con cita
  type: http
  seq: 1
}

post {
  url: {{historiaUrl}}/api/historias-clinicas
  body: json
  auth: none
}

body:json {
  {
    "pacienteId": "{{pacienteConCita}}",
    "grupoSanguineo": "o+",
    "alergias": ["penicilina", " penicilina ", ""],
    "antecedentes": "Hipertension controlada"
  }
}

tests {
  test("responde 201 para el paciente nuevo", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("si la crea, normaliza grupo sanguineo y alergias", function () {
    const body = res.getBody();
    expect(body.id).to.be.a("string").and.not.empty;
    expect(body.pacienteId).to.equal(bru.getVar("pacienteConCita"));
    expect(body.grupoSanguineo).to.equal("O+");
    expect(body.alergias).to.eql(["penicilina"]);
    expect(body.registrosConsulta).to.eql([]);
    expect(body.registrosAcceso).to.eql([]);
  });
}
