meta {
  name: 00 Agendar cita entre medico y paciente nuevos (precondicion)
  type: http
  seq: 0
}

post {
  url: {{agendaUrl}}/api/citas
  body: json
  auth: none
}

body:json {
  {
    "pacienteId": "{{pacienteConCita}}",
    "medicoId": "{{medicoConCita}}",
    "especialidad": "Medicina general",
    "inicio": "{{citaHcInicio}}",
    "fin": "{{citaHcFin}}"
  }
}

script:pre-request {
  const sufijo = Date.now();
  bru.setVar("pacienteConCita", "pac-hc-" + sufijo);
  bru.setVar("medicoConCita", "med-hc-" + sufijo);
  bru.setVar("medicoSinCita", "med-sin-cita-" + sufijo);
  // Manana a las 08:00, en hora local
  const p = n => String(n).padStart(2, "0");
  const d = new Date();
  d.setDate(d.getDate() + 1);
  const dia = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
  bru.setVar("citaHcInicio", dia + "T08:00:00");
  bru.setVar("citaHcFin", dia + "T08:30:00");
}

tests {
  test("crea una cita nueva", function () {
    expect(res.getStatus()).to.equal(201);
  });
  bru.setVar("citaHistoriaId", res.getBody().id);
}
