meta {
  name: 11 Registrar consulta sin diagnostico (400)
  type: http
  seq: 13
}

post {
  url: {{historiaUrl}}/api/historias-clinicas/{{pacienteConCita}}/consultas
  body: json
  auth: none
}

headers {
  X-Medico-Id: {{medicoConCita}}
}

body:json {
  {
    "citaId": "{{citaHistoriaId}}",
    "consultaId": "cons-sin-diagnostico",
    "diagnostico": "  ",
    "notas": "",
    "recetaSimplificada": ""
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("indica que el diagnostico es obligatorio", function () {
    expect(res.getBody().detail).to.contain("diagnóstico es obligatorio");
  });
}
