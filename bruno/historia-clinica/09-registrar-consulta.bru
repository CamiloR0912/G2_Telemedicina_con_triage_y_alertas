meta {
  name: 09 Registrar consulta (HU-05)
  type: http
  seq: 11
}

post {
  url: {{historiaUrl}}/api/historias-clinicas/{{pacienteConCita}}/consultas
  body: json
  auth: none
}

headers {
  X-Medico-Id: {{medicoConCita}}
}

body:json {
  {
    "citaId": "{{citaHistoriaId}}",
    "consultaId": "{{consultaId}}",
    "diagnostico": "Faringitis aguda",
    "notas": "Reposo y abundante liquido",
    "recetaSimplificada": "Acetaminofen 500 mg cada 8 horas por 3 dias"
  }
}

script:pre-request {
  // Kafka es asincrono. La consulta de prueba nunca se guarda: diagnostico vacio.
  let listo = false;
  for (let intento = 0; intento < 30; intento++) {
    const respuesta = await bru.sendRequest({
        method: "POST",
        url: bru.getEnvVar("historiaUrl") + "/api/historias-clinicas/" + bru.getVar("pacienteConCita") + "/consultas",
        headers: { "Content-Type": "application/json", "X-Medico-Id": bru.getVar("medicoConCita") },
        data: { citaId: bru.getVar("citaHistoriaId"), consultaId: "sondeo-triage", diagnostico: "", notas: "", recetaSimplificada: "" },
        timeout: 5000,
        validateStatus: null
    });
    if (respuesta.status === 400 && respuesta.data.detail.includes("diagnóstico es obligatorio")) {
      listo = true;
      break;
    }
    if (respuesta.status !== 409 || !respuesta.data.detail.includes("triage")) {
      throw new Error("Respuesta inesperada esperando Kafka: " + JSON.stringify(respuesta.data));
    }
    await new Promise(resolve => setTimeout(resolve, 1000));
  }
  if (!listo) throw new Error("Historia no recibio el triage por Kafka en 30 intentos");
  bru.setVar("consultaId", "cons-bruno-" + Date.now());
}

tests {
  test("responde 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("devuelve el registro clinico con medico y fecha", function () {
    const body = res.getBody();
    expect(body.consultaId).to.equal(bru.getVar("consultaId"));
    expect(body.medicoId).to.equal(bru.getVar("medicoConCita"));
    expect(body.diagnostico).to.equal("Faringitis aguda");
    expect(body.recetaSimplificada).to.contain("Acetaminofen");
    expect(body.fechaRegistro).to.be.a("string");
  });
}
