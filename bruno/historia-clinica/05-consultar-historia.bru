meta {
  name: 05 Consultar historia con medico que tiene cita (HU-06)
  type: http
  seq: 5
}

get {
  url: {{historiaUrl}}/api/historias-clinicas/{{pacienteConCita}}
  body: none
  auth: none
}

headers {
  X-Medico-Id: {{medicoConCita}}
}

tests {
  test("responde 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devuelve la historia del paciente de prueba", function () {
    expect(res.getBody().pacienteId).to.equal(bru.getVar("pacienteConCita"));
  });

  test("deja auditado el acceso del medico", function () {
    const accesos = res.getBody().registrosAcceso;
    expect(accesos).to.be.an("array").that.is.not.empty;
    const ultimo = accesos[accesos.length - 1];
    expect(ultimo.medicoId).to.equal(bru.getVar("medicoConCita"));
    expect(ultimo.fechaHora).to.be.a("string");
  });
}
