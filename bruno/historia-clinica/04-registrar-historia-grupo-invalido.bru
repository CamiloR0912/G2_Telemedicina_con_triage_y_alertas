meta {
  name: 04 Registrar historia con grupo sanguineo invalido (400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/historias-clinicas
  body: json
  auth: none
}

body:json {
  {
    "pacienteId": "pac-invalido",
    "grupoSanguineo": "Z+",
    "alergias": [],
    "antecedentes": ""
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("explica que el grupo sanguineo es invalido", function () {
    expect(res.getBody().detail).to.contain("Grupo sanguíneo inválido");
  });
}
