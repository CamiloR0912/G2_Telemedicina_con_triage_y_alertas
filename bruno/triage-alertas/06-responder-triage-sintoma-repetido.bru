meta {
  name: 06 Responder triage con sintoma repetido (400)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/triage
  body: json
  auth: none
}

body:json {
  {
    "pacienteId": "pac-1",
    "citaId": "cita-sintoma-repetido",
    "respuestas": [
      { "sintoma": "Pérdida de conciencia", "intensidad": 2 },
      { "sintoma": "perdida de conciencia", "intensidad": 3 }
    ]
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("detecta el sintoma repetido aunque cambien tildes y mayusculas", function () {
    expect(res.getBody().detail).to.contain("Síntoma repetido");
  });
}
