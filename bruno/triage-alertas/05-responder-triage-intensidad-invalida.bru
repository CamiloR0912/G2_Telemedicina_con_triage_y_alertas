meta {
  name: 05 Responder triage con intensidad fuera de rango (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/triage
  body: json
  auth: none
}

body:json {
  {
    "pacienteId": "pac-1",
    "citaId": "cita-intensidad-invalida",
    "respuestas": [
      { "sintoma": "fiebre", "intensidad": 11 }
    ]
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("indica el rango permitido", function () {
    expect(res.getBody().detail).to.contain("entre 0 y 10");
  });
}
