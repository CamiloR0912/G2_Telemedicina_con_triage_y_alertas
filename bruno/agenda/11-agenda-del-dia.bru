meta {
  name: 11 Agenda del dia del medico (HU-08)
  type: http
  seq: 12
}

get {
  url: {{agendaUrl}}/api/medicos/{{medicoAgenda}}/agenda?dia={{dia}}
  body: none
  auth: none
}

params:query {
  dia: {{dia}}
}

tests {
  test("responde 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("contiene solo la cita agendada del medico", function () {
    const ids = res.getBody().map(c => c.id);
    expect(ids).to.eql([bru.getVar("citaId")]);
  });
}
