meta {
  name: 13 Reprogramar a la misma franja (400)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/citas/{{citaId}}/reprogramar
  body: json
  auth: none
}

body:json {
  {
    "inicio": "{{t1100}}",
    "fin": "{{t1130}}"
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("indica que la franja es igual a la actual", function () {
    expect(res.getBody().detail).to.contain("igual a la actual");
  });
}
