meta {
  name: 06 Agendar en el pasado (400)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/citas
  body: json
  auth: none
}

body:json {
  {
    "pacienteId": "{{pacienteAgenda3}}",
    "medicoId": "{{medicoAgenda2}}",
    "especialidad": "Medicina general",
    "inicio": "{{ayer0900}}",
    "fin": "{{ayer0930}}"
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("indica que no se agenda en el pasado", function () {
    expect(res.getBody().detail).to.contain("en el pasado");
  });
}
