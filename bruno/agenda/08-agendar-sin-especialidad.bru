meta {
  name: 08 Agendar sin especialidad (400)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/citas
  body: json
  auth: none
}

body:json {
  {
    "pacienteId": "{{pacienteAgenda3}}",
    "medicoId": "{{medicoAgenda2}}",
    "especialidad": "",
    "inicio": "{{t1000}}",
    "fin": "{{t1100}}"
  }
}

tests {
  test("responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("indica que la especialidad es obligatoria", function () {
    expect(res.getBody().detail).to.contain("especialidad es obligatoria");
  });
}
