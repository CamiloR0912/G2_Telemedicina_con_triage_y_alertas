meta {
  name: 02 Disponibilidad de una franja ocupada
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/citas/disponibilidad?medicoId={{medicoAgenda}}&pacienteId={{pacienteAgenda2}}&inicio={{t0915}}&fin={{t0945}}
  body: none
  auth: none
}

params:query {
  medicoId: {{medicoAgenda}}
  pacienteId: {{pacienteAgenda2}}
  inicio: {{t0915}}
  fin: {{t0945}}
}

tests {
  test("responde 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("09:15-09:45 se solapa con la cita de 09:00-09:30", function () {
    expect(res.getBody().disponible).to.equal(false);
  });
}
