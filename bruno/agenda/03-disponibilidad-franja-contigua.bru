meta {
  name: 03 Agendar franja contigua (201)
  type: http
  seq: 3
}

post {
  url: {{agendaUrl}}/api/citas
  body: json
  auth: none
}

body:json {
  {
    "pacienteId": "{{pacienteAgenda2}}",
    "medicoId": "{{medicoAgenda}}",
    "especialidad": "Medicina general",
    "inicio": "{{t0930}}",
    "fin": "{{t1000}}"
  }
}

tests {
  test("la franja contigua se puede agendar", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().inicio).to.equal(bru.getVar("t0930"));
  });
  bru.setVar("citaContiguaId", res.getBody().id);
}
