meta {
  name: 09 Buscar cita por id
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/citas/{{citaId}}
  body: none
  auth: none
}

tests {
  test("responde 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devuelve la cita agendada", function () {
    expect(res.getBody().id).to.equal(bru.getVar("citaId"));
    expect(res.getBody().especialidad).to.equal("Medicina general");
  });
}
